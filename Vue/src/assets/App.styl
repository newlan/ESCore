/* 定义呼吸灯动画 */
@keyframes breatheWarning {
  0% {
    box-shadow: 0 0 4px rgba(255, 77, 79, 0.2);
    border-color: rgba(255, 77, 79, 0.6);
  }
  50% {
    /* 动画进行到一半时，光晕扩大，颜色变深 */
    box-shadow: 0 0 16px rgba(255, 77, 79, 0.8);
    border-color: rgba(255, 77, 79, 1);
  }
  100% {
    box-shadow: 0 0 4px rgba(255, 77, 79, 0.2);
    border-color: rgba(255, 77, 79, 0.6);
  }
}

/* 触发警告的卡片样式类 */
.amount-warning-card {
  /* 确保边框颜色有明显的警示感 */
  border: 1px solid #ff4d4f !important; 
  /* 应用动画：3秒一个周期，无限循环，平滑过渡 */
  animation: breatheWarning 3s infinite ease-in-out;
  /* 避免激烈的颜色突变 */
  transition: all 0.3s ease; 
}
