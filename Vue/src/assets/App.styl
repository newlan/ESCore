	opacity: 0; 

  /* 主题色 */
  --theme-color: #ff445b;
  
.a02-enter-active,
.a02-leave-active 
    position: absolute;
    transition: all .4s ease;
.a02-enter-from 
    right : -100%;
    opacity: 1; 
    transform: scale(1);
.a02-enter-to
    right : 0%;
    opacity: 0; 
    transform: scale(1);
.a02-leave-from 
    transform: scale(1);
    left : 0%
    opacity: 0; 
.a02-leave-to
    opacity: 1;
    left -100%
    transform: scale(1);

// 字体颜色闪烁动画
.font_color_flicker
    -webkit-animation: fongt_flicker 1s infinite; /* Chrome, Safari, Opera */
    animation: fongt_flicker 1s infinite cubic-bezier(0.47, 0, 0.75, 0.72);
    color:#fff;
    font-weight: bold
@keyframes fongt_flicker
    50% {color:red;font-weight: bold;}
// 字体颜色闪烁动画 end
.ask_pay 
    -webkit-animation: mymove 1s infinite; /* Chrome, Safari, Opera */
    animation: mymove 1s infinite cubic-bezier(0.47, 0, 0.75, 0.72);
    border-radius: 5px;
    box-shadow: 0 0 6px rgb(255, 255, 255);
.ask_fin 
    -webkit-animation: mymove3 1s infinite; /* Chrome, Safari, Opera */
    animation: mymove3 1s infinite cubic-bezier(0.47, 0, 0.75, 0.72);
    border-radius: 5px;
    box-shadow: 0 0 6px rgb(255, 255, 255);
.flicker1 
    -webkit-animation: flicker1 1s infinite; /* Chrome, Safari, Opera */
    animation: flicker1 1s infinite cubic-bezier(0.47, 0, 0.75, 0.72);
@-webkit-keyframes mymove 
    50% {box-shadow: 0 0 6px red;}
.inset_01
    -webkit-animation: mymove1 1s infinite; /* Chrome, Safari, Opera */
    animation: mymove1 1s infinite cubic-bezier(0.47, 0, 0.75, 0.72);
.s_red
    -webkit-animation: mymove2 1s infinite; /* Chrome, Safari, Opera */
    animation: mymove2 1 infinite cubic-bezier(0.47, 0, 0.75, 0.72);
    
@keyframes mymove3
    50% {box-shadow: 0 0 6px #68e}
@keyframes mymove2 
    50% {background: rgba(56, 11, 11 , .61);}
@keyframes mymove 
    50% {box-shadow: 0 0 6px red;}
@keyframes mymove1 
    50% {box-shadow: inset 0 0 10px red;}
@-webkit-keyframes flicker1 
    50% {background:rgba(230,162,60,.12);}

@keyframes flicker1 
    50% {background:rgba(230,162,60,.12);}

