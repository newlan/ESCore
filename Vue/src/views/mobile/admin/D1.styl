.w100 
    width: 100%;
.slide-fade-move
    transition: all .8s ease;

.slide-fade-enter-active 
    transition: all 0.8s ease-in;
.slide-fade-leave-active 
    transition: all 0.8s ease-out;position: absolute;
.slide-fade-enter-from
    transform: scale(1.5) rotateX(80deg) translateY(-80px);opacity: 0.3;
.slide-fade-leave-to 
    transform: scale(1.5) rotateX(-80deg) translateY(-100px) translateX(100px);opacity: 0;
    
.user1-move
    transition: all .8s ease;

.user1-enter-active 
    // transition: all 0.8s ease-out;
    transition: all 0.8s  cubic-bezier(0.17, 1.06, 0.39, 1.43);
.user1-leave-active 
    // transition: all 0.8s ease-in;
    transition: all 0.8s cubic-bezier(0.6, -0.48, 0.74, 0.05);
    position: absolute;
    z-index: 9999;
.user1-enter-from
    transform: scale(1) translateX(195px);opacity: 0.5;
.user1-leave-to 
    transform: scale(1) translateX(-195px);opacity: 0;

