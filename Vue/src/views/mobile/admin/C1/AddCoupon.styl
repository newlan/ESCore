// item 行间距
row-span = 10px
.AddCoupon
    .from
        padding: 10px;overflow: auto;
        .el-input-group__prepend,.el-input-group__append 
            padding: 0 6px;
        .el-form-item--default
            margin-bottom: row-span;
        .el-transfer__buttons
            display none;
        .exchange
            margin-top: row-span
        .el-transfer-panel
            width auto;flex:1;
        .el-transfer-panel:last-child
            margin-left: 5px;flex: 1.2;
        .el-transfer-panel__filter
            margin: 5px;
        .el-checkbox__label
            font-size: 12px;
        .el-checkbox
            margin-right: 10px;
        .el-transfer-panel__item
            padding-left: 8px;
        .exa
            background: #f5f5f5; padding: 5px;border-radius: 5px;
            .e2 
                line-height: 0;margin-top:5px
            .c_row 
                border-radius: 5px;padding: 3px;background: #ff6363; margin-top: 5px;
        .form_item_row 
            width: 100%; align-items: stretch; line-height: 1; display: flex; border-radius: 3px; align-items: center;
            .item_content 
                margin-left: 5px;
            .item_label 
                background-color: #f5f7fa; color: #909399; vertical-align: middle; line-height: 30px; padding: 0 6px; white-space: nowrap; border: 1px solid #dcdfe6; border-radius: 3px 0px 0px 3px;
            // 自定义时间
            .custom_time
                flex: 1;
                .el-input__inner
                    padding-left: 10px;padding-right: 10px;margin-left:5px;



