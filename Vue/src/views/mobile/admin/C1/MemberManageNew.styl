.MemberManage
    text-align: center;
    .list 
        .concon 
            overflow: auto;padding 5px; text-align: left;
            .novip 
                color: #bbbbbb; padding: 20px; font-size: 14px;
            .vip_0
                box-shadow: 0 0 2px #d6d6d6; border-radius: 5px; margin-bottom: 10px;
            .open_ 
                padding 0 5px 5px 5px;
                .open_1 
                    display: flex; flex-direction: row; text-align: center; font-size: 12px; border: 1px solid #e9e9e9; border-radius: 5px;
                    .price 
                        margin: 0 3px
                        .t 
                            padding: 3px; color: #c2c2c2;
                        .t1 
                            margin-bottom: 3px;
                        .t2 
                            display flex;
                            .el-button+.el-button
                                margin-left: 3px;
            .vip_ 
                display: flex; flex-direction: row; padding: 5px; 
                .name 
                    min-width: 70px; max-width: 100px;margin-right: 5px;
                    .n 
                        text-align: center; color: #409eff; font-size: 15px;
                    .p0 
                        text-align: center;padding-top: 3px;
                        .p 
                            background: #f1f1f1; border-radius: 5px; font-size: 12px; color: #b4b4b4; padding: 2px 6px;
                            .d 
                                text-decoration: line-through;
                            .r 
                                color #E91E63;
                .info 
                    flex 1; display: flex; flex-direction: column; justify-content: space-around;
                    .d 
                        text-decoration: line-through;
                    .tip_price 
                        font-size: 12px; background: #FF9800; color: #fff; padding: 1px 5px; border-radius: 5px;
                    .out_price 
                        font-size: 12px; background: #9C27B0; color: #fff; padding: 1px 5px; border-radius: 5px;
                    .jump 
                        font-size: 12px; background: #409eff; color: #fff; padding: 1px 5px; border-radius: 5px;
                    .jump2 
                        font-size: 12px; background: #e5e5e5; color: #fff; padding: 1px 5px; border-radius: 5px;
                    .jump4 
                        font-size: 12px; background: #6d6d6d; color: #e3e3e3; padding: 1px 5px; border-radius: 5px;
                    .jump5 
                        font-size: 12px; background: #9c27b0; color: #e3e3e3; padding: 1px 5px; border-radius: 5px;
                    .jump3 
                        font-size: 12px; background: #00BCD4; color: #fff; padding: 1px 5px; border-radius: 5px;
                    .i 
                        color: #777777; font-size: 13px; padding-right: 5px; padding-top: 3px;
                .edit 
                    display: flex; align-items: center;
        .r 
            border-bottom: 1px solid whitesmoke;align-items: center;padding: 7px 5px;
            .r1
                color: #409eff; font-size: 15px;
            .r2 
                font-size: 12px; margin-top: 5px;
                .r21
                    background: #ebebeb; padding: 0 5px; border-radius: 5px; color: #b9b9b9;
            .r3 
                font-size: 12px; background: #409eff; color: white; padding: 1px 5px; border-radius: 5px;
            .r4 
                font-size: 12px; background: #e5e5e5; color: white; padding: 1px 5px; border-radius: 5px;
            .r5 
                color: #6e6e6e; font-size: 13px;    margin-top: 5px;
.el-form-item--default
    margin-bottom: 10px;