.MemberAdmin
   margin: 6px;padding: 5px; border: 1px solid #fff; border-radius: 7px; overflow: hidden; box-shadow: 0 0 5px #cdcdcd; background: #f2f7f9;
.a-row {
  margin-bottom: 20px;
}
.a-row:last-child {
  margin-bottom: 0;
}
.a-col {
  border-radius: 4px;
}
.grid-content {
  border-radius: 4px;
  min-height: 36px;
}
 .el-checkbox__input.is-checked .el-checkbox__inner, .el-checkbox__input.is-indeterminate .el-checkbox__inner{
    background-color:rgba(47, 84, 201, 1);;
    border-color: rgba(47, 84, 201, 1);;
  }
  .el-checkbox__input.is-checked + .el-checkbox__label {
    color: rgba(47, 84, 201, 1);;
  }
  .el-checkbox.is-bordered.is-checked{
    border-color: rgba(47, 84, 201, 1);;
  }
  .el-checkbox__input.is-focus .el-checkbox__inner{
    border-color:  rgba(47, 84, 201, 1);;
  }