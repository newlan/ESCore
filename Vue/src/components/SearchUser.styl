                .t2 
                    line-height: 1; color: #979797;padding-top: 2px;
            .p1 
                padding: 2px; background: #1890ff; border-radius: 2px; color: white; 
            .p2 
                border: 1px solid; padding: 0 3px; text-align: center; border-radius: 3px; 
