.SearchUser
    border-bottom: 1px solid #ffffff;
    box-shadow: 0 0 6px #3e3e3e;display: flex;flex-direction: column; position: absolute; width: 100%; max-height: 50%; z-index: 999; background: #fbfbfb; top: 0; left: 0;
    .search
        padding: 10px;
    .but
        width: 100%;padding: 10px;border-top: 1px solid #e3e3e3;
        .w100
            width :100%;
    .DBlist
        padding: 10px;
        background: #fff;
        flex 1;overflow auto;
        .noList
            background: white; padding: 10px; border-radius: 10px; color: #d1d1d1;text-align: center;
        .avatar
            padding: 6px; position: relative;
            .vip 
                position: absolute; background: red; font-size: 11px; padding: 1px 6px; border-radius: 5px 0 5px 0; top: 0; left: 0; color: #ffffff;
            .av 
                width: 101%; padding-bottom: 100%; border: 1px solid #fdfdfd; height: 0; border-radius: 50%; overflow: hidden;
                .img    
                    width: 102%; 
        .mp 
            margin: 8px 5px;box-shadow: 0 0 2px #dadada; border-radius: 5px;
        .row 
            border-radius: 8px; box-shadow: 1px 1px 2px #efefef;
